# podvm synthetic kernel config
# Minimal Linux kernel for podvm guests
# Build: make -C linux-x86_64 defconfig && cp config linux-x86_64/.config && make -C linux-x86_64 olddefconfig && make -C linux-x86_64 -j$(nproc) bzImage

# ──── Processor ────
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_X86_64=y

# ──── Paravirtualization ────
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# ──── Virtio Drivers (built-in) ────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y

# ──── 9p (container rootfs share) ────
# 9p is the rootfs transport until the performance phase (ADR-022), when
# virtiofs returns. CONFIG_NET_9P depends on CONFIG_NET, so a minimal net
# stack is unavoidable -- see ADR-022 for the attack-surface tradeoff.
CONFIG_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# ──── Vsock (host↔guest IPC) ────
CONFIG_VSOCK=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# ──── Filesystems ────
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ──── Namespaces (container isolation) ────
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# ──── Seccomp (syscall filtering) ────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ──── Capabilities ────
CONFIG_SECURITY=y
CONFIG_SECURITY_CAPABILITIES=y

# ──── Essential ────
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_EVENTFD=y

# ──── Kernel hardening ────
CONFIG_CC_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# ──── Kernel ────
CONFIG_KERNEL_UNCOMPRESSED=y

# ──── Explicitly removed (attack surface) ────
# BPF            - VM inside kernel, massive CVE history
# VIRTIO_MMIO    - not needed with PCI
# VIRTIO_BLK     - no block devices
# VIRTIO_NET     - no guest networking
# VIRTIO_RNG     - not critical
# VT/VT_CONSOLE  - use serial only
# BUG            - debug assertions
# TIMERFD        - extra syscall surface
# AIO            - not needed
# TMPFS_XATTR    - xattr parsing bugs
# CRYPTO_*       - uncompressed initrd
# MODULES        - everything built-in
# FTRACE         - tracing subsystem
# KPROBES        - dynamic tracing
# PERF_EVENTS    - perf counters
# DEBUG_FS       - debug filesystem
# KGDB           - kernel debugger
# MAGIC_SYSRQ    - magic sysrq key
# AUDIT          - audit subsystem
# APPARMOR       - security module
# SELINUX        - security module
# YAMA           - security module
# ACPI           - power management
# PM             - power management
# SUSPEND        - suspend/resume
# HIBERNATION    - hibernation
# OVERLAY_FS     - host handles this
# EXT4/BTRFS/XFS - no local disks
# NFS/CIFS       - no network filesystems
# VIRTIO_FS      - deferred to performance phase (ADR-022); 9p is primary now
# ATA/SCSI/USB   - no hardware
# SOUND/DRM      - no GUI
# WLAN/BLUETOOTH - no wireless
# INFINIBAND     - no RDMA
